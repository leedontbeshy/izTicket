  "info": {
    "_postman_id": "2f45f62e-6f74-4a75-8f45-000000000001",
    "name": "izTicket API",
    "description": "Postman collection for the NestJS API under /api/v1. Suggested smoke flow: register/login organizer, create event, create ticket type, submit event, login admin, approve event, login customer, create reservation, create order. Admin registration is blocked by the API, so use a seeded admin account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function isoDays(days, hour) {",
          "  const d = new Date();",
          "  d.setUTCDate(d.getUTCDate() + days);",
          "  d.setUTCHours(hour, 0, 0, 0);",
          "  return d.toISOString();",
          "}",
          "",
          "pm.collectionVariables.set('saleStartsAt', isoDays(-1, 0));",
          "pm.collectionVariables.set('saleEndsAt', isoDays(29, 23));",
          "pm.collectionVariables.set('eventStartsAt', isoDays(30, 10));",
          "pm.collectionVariables.set('eventEndsAt', isoDays(30, 13));"
        ]
      }
    }
  ],
