        {
          "name": "Refresh Session",
          "description": "Uses the izticket_refresh_token cookie set by login. Postman cookie jar should send it automatically for /api/v1/auth.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "if (data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  const byRole = { CUSTOMER: 'customerAccessToken', ORGANIZER: 'organizerAccessToken', ADMIN: 'adminAccessToken' };",
                  "  if (data.user && byRole[data.user.role]) pm.collectionVariables.set(byRole[data.user.role], data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
